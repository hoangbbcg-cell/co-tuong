[Unit]
Description=Local compressed backup of the isolated Co Tuong test database
After=mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/cotuong-local-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/cotuong-stage
