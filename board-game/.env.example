# Backend only. Copy to .env and fill your password locally.
# Quote passwords containing # or spaces. Never prefix these keys with VITE_.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cotuong
DB_USER=cotuong_app
DB_PASSWORD=

# Same Google OAuth Web client ID in both lines. No client secret is used.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
