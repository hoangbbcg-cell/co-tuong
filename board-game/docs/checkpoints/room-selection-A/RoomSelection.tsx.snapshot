import { CreateRoomForm } from './CreateRoomForm'
import { PlayerNameValidationDialog } from './PlayerNameValidationDialog'
import background from '../../../assets/backgrounds/computer.png'
import buttonImage from '../../../assets/room-selection/brown-card-upload.png'
import quickImage from '../../../assets/room-selection/red-card-upload.png'
import emptyBoard from '../../../assets/room-selection/empty-board-upload.png'
import provincePickerFrame from '../../../assets/room-selection/province-picker-frame.png'
import provinceCard from '../../../assets/room-selection/province-card.png'
import { ROOM_MINUTES } from '../../../types/room'
import type { useLobby } from '../hooks/useLobby'
import type { useHomeMusic } from '../hooks/useHomeMusic'
import { useRoomSelection } from '../hooks/useRoomSelection'
import { useRoomEntrance } from '../../game/hooks/useRoomEntrance'
import { OpeningCover } from '../../game/components/OpeningCover'
import { HomeIcon } from './HomeIcon'
import { buttonInteraction, gameUtilityButton, homeUtilityButton } from '../../../lib/uiClasses'
import { GameBackIcon } from '../../game/components/GameBackIcon'
import { AvatarFrameOverlay } from '../../game/components/AvatarFrameOverlay'
import { AvatarPortrait } from './AvatarCustomization'
import { getAvatarFrame } from '../../../lib/avatarFrames'
import { useSessionStore } from '../../../store/sessionStore'
import { roomProvinceIcon, roomProvinceLabel } from './roomProvinces'
import { useVietnamAdministrativeUnits } from '../hooks/useVietnamAdministrativeUnits'

type Props = { lobby: ReturnType<typeof useLobby>; music: ReturnType<typeof useHomeMusic>; onClose: () => void; onEntranceComplete: () => void }
const coin = `${homeUtilityButton} shrink-0`

function Avatar({ empty = false, header = false }: { empty?: boolean; header?: boolean }) {
  return <span className={`grid aspect-square ${header ? 'w-full' : 'w-[22%]'} max-w-14 shrink-0 cursor-pointer place-items-center rounded-full border-2 ${empty ? 'border-dashed border-[#ab9776]/70' : 'border-[#e4d6bd] bg-[linear-gradient(#646b6d,#242b2e)] shadow-[0_3px_2px_#0009]'}`}>
    {!empty && <svg viewBox="0 0 40 40" className="w-full" aria-hidden="true"><path fill="#f1f1eb" d="M8 35q-2-7 8-10v-4q-4-3-4-9 0-9 8-9t8 9q0 6-4 9v4q10 3 8 10Z" /></svg>}
  </span>
}

function MiniBoard() {
  return <svg viewBox="0 0 110 120" className="w-[48%] max-w-28 drop-shadow-[0_4px_2px_#0009]" aria-hidden="true">
    <defs><linearGradient id="room-wood" x2="1" y2="1"><stop stopColor="#ad762e"/><stop offset="1" stopColor="#503010"/></linearGradient><radialGradient id="room-face"><stop stopColor="#c48b37"/><stop offset="1" stopColor="#8b521b"/></radialGradient></defs>
    <rect x="2" y="2" width="106" height="116" rx="7" fill="url(#room-wood)" stroke="#6e491f" strokeWidth="3"/>
    <rect x="9" y="10" width="92" height="100" fill="url(#room-face)" stroke="#36200e" strokeWidth="3"/>
    <g stroke="#573711" strokeWidth=".7">{Array.from({length: 10}, (_, i) => <path key={`h${i}`} d={`M15 ${16+i*10}h80`}/>)}{Array.from({length: 9}, (_, i) => <path key={`v${i}`} d={`M${15+i*10} 16v40m0 10v40`}/>)}<path d="m45 16 20 20m0-20-20 20m0 50 20 20m0-20-20 20"/></g>
    <g fill="#f4d28b" stroke="#916129" strokeWidth=".6">{[15,35,55,75,95].map(x => <circle key={x} cx={x} cy="16" r="3"/>)}<circle cx="55" cy="66" r="3.6"/><circle cx="15" cy="86" r="3"/><circle cx="95" cy="86" r="3"/></g>
  </svg>
}

const framedButton = `${buttonInteraction} border-0 bg-transparent bg-[length:100%_100%] bg-no-repeat text-[#fff0ce] hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50`

export function RoomSelection({ lobby, music, onClose, onEntranceComplete }: Props) {
  const selection = useRoomSelection(lobby)
  const provinceOptions = useVietnamAdministrativeUnits(selection.provincePickerOpen, null)
  const provinceLabel = roomProvinceLabel(selection.province)
  const entrance = useRoomEntrance(onEntranceComplete)
  const avatarIndex = useSessionStore(state => state.avatarIndex)
  const avatarFrameIndex = useSessionStore(state => state.avatarFrameIndex)
  return <><div ref={entrance.sceneRef} data-testid="lobby-entrance" data-entering={entrance.entering} style={{ clipPath: 'inset(0)' }} className="relative isolate flex h-full min-h-0 flex-col overflow-hidden pb-5 font-[Arial,sans-serif] compact:pb-3">
    <img src={background} alt="" className="pointer-events-none absolute inset-0 -z-20 size-full object-cover" />
    <div aria-hidden="true" className="pointer-events-none absolute inset-0 -z-10 bg-black/15" />
    <button type="button" className={`${gameUtilityButton} absolute left-3 top-1 z-30 compact:top-0`} aria-label="Đóng" onClick={onClose}><GameBackIcon /></button>
    <div inert={entrance.entering} className="contents">
    <header className="flex h-[56px] shrink-0 items-center gap-6 border-b-2 border-[#b78136] bg-[#130e08]/85 px-10 compact:h-12 compact:gap-3 compact:px-4">
      <span aria-hidden="true" className="w-[57px] shrink-0 compact:w-[48px]" />
      <div className="flex min-w-0 flex-1 items-center gap-3"><span role="img" aria-label="Avatar người chơi" className="relative size-[45px] shrink-0 self-center rounded-full compact:size-[33px]"><AvatarPortrait avatarIndex={avatarIndex} className="size-full rounded-full"/><AvatarFrameOverlay src={getAvatarFrame(avatarFrameIndex).image} /></span><input className="w-full max-w-48 self-center border-0 bg-transparent py-0 font-heading text-2xl leading-none text-[#eee4ce] lining-nums tabular-nums outline-none compact:text-lg" aria-label="Tên người chơi" value={lobby.name} onChange={event => lobby.setName(event.target.value)} /></div>
      <nav className="flex flex-wrap shrink-0 items-center justify-end gap-[10px]" aria-label="Tiện ích">
        <button className={coin} aria-label="Bạn bè" onClick={() => selection.setMessage('Tính năng bạn bè sắp ra mắt.')}><HomeIcon name="friends"/></button>
        <button className={coin} aria-label="Thành tích" onClick={() => selection.setMessage('Thành tích sắp ra mắt.')}><HomeIcon name="trophy"/></button>
        <button className={coin} aria-label={music.playing ? 'Tắt nhạc' : 'Bật nhạc'} aria-pressed={music.playing} onClick={() => void music.toggle().catch(() => selection.setMessage('Không thể phát nhạc trên trình duyệt này.'))}><HomeIcon name={music.playing ? 'sound' : 'muted'}/></button>
      </nav>
    </header>
    <div className="mx-auto flex min-h-0 w-[calc(88%-180px)] flex-1 flex-col pt-3 compact:w-[88%] compact:pt-2">
      <div className="grid shrink-0 grid-cols-[3fr_2.5fr_4fr] gap-3 px-[10px] compact:grid-cols-2 compact:gap-2">
        <button type="button" aria-label={`Chọn tỉnh/thành phố, hiện tại ${provinceLabel}`} onClick={() => selection.setProvincePickerOpen(true)} className={`${framedButton} relative isolate flex h-[72px] items-center gap-3 px-6 py-[5px] compact:h-[64px] compact:gap-1 compact:px-3`}>
          <img src={buttonImage} alt="" aria-hidden="true" className="pointer-events-none absolute inset-0 z-0 size-full object-fill" />
          <img src={roomProvinceIcon(selection.province)} alt="" className="relative z-10 block max-h-[56px] w-14 shrink-0 object-contain compact:max-h-12 compact:w-12"/>
          <h2 id="roomSelectionTitle" className="sr-only">Chọn Bàn</h2>
          <div className="relative z-10 min-w-0 flex-1 text-left">
            <p title={provinceLabel} className="relative top-[5px] truncate font-heading text-[22px] leading-tight compact:text-lg">{provinceLabel}</p>
            <p className="mt-1 flex gap-x-4 text-base compact:gap-x-2 compact:text-sm">
              <span className="flex items-center gap-1" aria-label={`${lobby.rooms.filter(room => room.province === selection.province).length} bàn đang được tạo tại ${provinceLabel}`}><span aria-hidden="true" className="text-[22px] leading-none compact:text-lg">▦</span><span className="font-number text-xl compact:text-base">{lobby.rooms.filter(room => room.province === selection.province).length}</span></span>
              <span className="flex items-center gap-1" aria-label={`${selection.players} người ở trang Chọn Bàn tại ${provinceLabel}`}><span aria-hidden="true" className="text-[22px] leading-none compact:text-lg">♟</span><span className="font-number text-xl compact:text-base">{selection.players}</span></span>
            </p>
          </div>
        </button>
        <button aria-label="Tạo bàn" className={`${framedButton} relative isolate flex h-[72px] items-center justify-center gap-2 compact:h-[64px]`} onClick={() => selection.setCreating(true)} disabled={lobby.pending}><img src={buttonImage} alt="" aria-hidden="true" className="pointer-events-none absolute inset-0 z-0 size-full object-fill"/><span className="relative z-10 font-heading text-[22px] compact:text-lg">Tạo bàn</span><span aria-hidden="true" className="relative z-10 font-number text-4xl leading-none compact:text-3xl">＋</span></button>
        <div ref={selection.quickTimeRef} style={{ backgroundImage: `url(${quickImage})` }} className="relative flex h-[72px] items-center bg-transparent bg-[length:100%_100%] bg-no-repeat px-3 text-[#fff0ce] compact:col-span-2 compact:h-[64px]">
          <button className={`${buttonInteraction} flex min-w-0 flex-1 items-center justify-center gap-2 py-2 text-[22px] hover:brightness-110 disabled:opacity-50 compact:text-lg`} disabled={lobby.pending || lobby.loading || !lobby.name.trim()} onClick={selection.quickPlay}><span aria-hidden="true" className="text-4xl leading-none compact:text-3xl">⚔</span><span className="font-heading">Chơi nhanh</span><span className="border-l border-[#e4ac57]/50 pl-2 font-heading"><span className="font-number">{selection.quickMinutes}</span> phút</span></button>
          <button type="button" className={`${buttonInteraction} grid size-10 shrink-0 place-items-center text-3xl hover:bg-black/20`} aria-label="Chọn thời gian Chơi nhanh" aria-expanded={selection.timeOpen} aria-controls="room-time-options" onClick={() => selection.setTimeOpen(!selection.timeOpen)}><svg viewBox="0 0 24 24" className="size-7" fill="none" stroke="currentColor" strokeWidth="3" aria-hidden="true"><path d="m5 9 7 7 7-7"/></svg></button>
          {selection.timeOpen && <div id="room-time-options" role="listbox" aria-label="Thời gian Chơi nhanh" className="absolute right-0 top-full z-20 mt-1 flex w-28 flex-col gap-1 rounded-md border border-[#b78a47] bg-[#382717]/95 p-1.5 shadow-[0_4px_12px_#0009]" onKeyDown={event => { if (event.key === 'Escape') selection.setTimeOpen(false) }}>{ROOM_MINUTES.map(minutes => <button key={minutes} type="button" role="option" aria-selected={selection.quickMinutes === minutes} className={`${buttonInteraction} flex h-8 w-full items-center justify-center rounded-sm bg-[#2b160edb] px-2 font-number text-base text-[#ffe7b6] hover:bg-[#613014]`} onClick={() => { selection.setQuickMinutes(minutes); selection.setTimeOpen(false) }}>{minutes} phút</button>)}</div>}
        </div>
      </div>
      {lobby.error && <p role="alert" className="mt-2 shrink-0 rounded bg-red-950/90 p-2 text-sm text-red-100">{lobby.error}</p>}
      {selection.message && <div role="status" className="mt-2 flex shrink-0 items-center justify-between gap-3 rounded border border-[#8d6a3b] bg-[#49321e] p-2 text-sm">{selection.message}<button onClick={() => selection.setMessage('')} aria-label="Ẩn thông báo">✕</button></div>}
      <section aria-label="Phòng online" aria-busy={lobby.loading} className="relative isolate mt-2 mb-6 flex min-h-0 flex-1 flex-col p-[20px] compact:p-[14px]">
        <span aria-hidden="true" className="pointer-events-none absolute inset-0 z-0 rounded-md border border-[#bd914e] bg-[#2C1408]/65" />
        <span aria-hidden="true" className="pointer-events-none absolute inset-[4px] z-20 rounded-sm border border-[#bd914e]" />
        <span aria-hidden="true" className="pointer-events-none absolute inset-0 z-20">{['absolute left-1 top-1', 'absolute right-1 top-1 rotate-90', 'absolute right-1 bottom-1 rotate-180', 'absolute left-1 bottom-1 -rotate-90'].map(position => <svg key={position} viewBox="0 0 40 40" fill="none" stroke="#f4d995" strokeWidth="1.5" className={`${position} size-8`}><path d="M2 38V14h12V2h24M2 24h22V2M8 30V8h22M2 14h12V2M8 20h12V8M2 38l6-6v-8M38 2l-6 6h-8" /></svg>)}</span>
        {selection.rooms.length > 0 ? <div className="relative z-10 grid min-h-0 flex-1 auto-rows-min grid-cols-3 content-start gap-x-4 gap-y-6 overflow-y-auto p-3 compact:grid-cols-2 compact:gap-x-2 compact:p-1">
          {selection.rooms.map(room => <button key={room.id} className={`${buttonInteraction} flex min-w-0 flex-col items-center justify-center gap-3 disabled:cursor-not-allowed`} aria-label={`Vào phòng ${room.name}, ${room.players}/2 người`} disabled={lobby.pending || !lobby.name.trim()} onClick={() => lobby.join(room.id)}>
            <span className="flex w-full items-center justify-center gap-1"><Avatar empty={room.players === 0}/><MiniBoard/><Avatar empty={room.players < 2}/></span>
            <span className="w-full truncate text-center text-lg compact:text-sm"><span className="font-number">{room.minutes ?? 10}′</span> · {room.name}</span><span className="-mt-2 text-xs text-[#e1c18b]">{room.phase === 'playing' ? 'Đang chơi · Có thể xem' : room.players >= 2 ? 'Đủ người · Có thể xếp hàng' : 'Còn trống'}</span>
          </button>)}
        </div> : <div className="relative z-10 flex min-h-0 flex-1 flex-col items-center justify-center gap-4 overflow-y-auto px-2 py-3"><img src={emptyBoard} alt="" className="block w-[137px] max-w-[25%] shrink-0 object-contain"/><p className="text-center text-lg leading-relaxed text-[#f4d995] compact:text-sm">{lobby.loading ? 'Đang tải danh sách bàn…' : selection.vacantOnly ? 'Chưa có bàn trống. Tạo bàn để mời bạn cùng chơi.' : 'Chưa có bàn nào. Hãy tạo bàn đầu tiên!'}</p></div>}
      </section>
    </div>
    <footer className="shrink-0 pt-2">
      <div className="mx-auto flex max-w-full justify-center gap-2" aria-label="Lọc bàn">{[false, true].map(vacant => <button key={String(vacant)} aria-pressed={selection.vacantOnly === vacant} onClick={() => selection.setVacantOnly(vacant)} className={`${buttonInteraction} grid h-[34px] w-[140px] max-w-[42%] place-items-center rounded-[3px] border border-[#dfc49c] px-3 text-sm shadow-[inset_0_0_0_1px_#f7e3bd44,0_2px_3px_#0005] hover:brightness-110 ${selection.vacantOnly === vacant ? 'bg-[linear-gradient(#e3cba6,#bea07a)] text-[#392715]' : 'bg-[linear-gradient(#705437,#4a3422)] text-[#ddc5a2]'}`}>{vacant ? 'Còn trống' : 'Tất cả'}</button>)}</div>
    </footer>
    {selection.creating && <div className="absolute inset-0 z-30 grid place-items-center bg-black/65 p-5"><CreateRoomForm lobby={lobby} province={selection.province} onCancel={() => selection.setCreating(false)} /></div>}
    {selection.provincePickerOpen && <div className="absolute inset-0 z-40 grid place-items-center bg-black/75 p-4 compact:p-2" onMouseDown={event => { if (event.target === event.currentTarget) selection.setProvincePickerOpen(false) }}>
      <section role="dialog" aria-modal="true" aria-labelledby="room-province-title" className="relative aspect-[1391/982] w-full max-w-[min(920px,124dvh)] border-0 bg-transparent p-0 text-[#ffe7b2]">
        <img src={provincePickerFrame} alt="" aria-hidden="true" className="pointer-events-none absolute inset-0 block size-full" />
        <div className="absolute left-[24%] top-[1%] flex h-[14%] w-[52%] min-w-0 items-center justify-center"><h2 id="room-province-title" className="truncate text-center font-heading text-3xl text-[#ffe7b2] compact:text-xl">Chọn tỉnh / thành phố</h2></div>
        <button type="button" aria-label="Đóng chọn tỉnh/thành phố" onClick={() => selection.setProvincePickerOpen(false)} className={`${buttonInteraction} absolute right-[1%] top-[9%] h-[10%] w-[7%] border-0 bg-transparent p-0 leading-none hover:brightness-125`} />
        <div className="absolute inset-x-[3%] top-[19%] bottom-[4%] min-h-0 overflow-y-auto p-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {provinceOptions.provincesLoading && <p role="status" className="p-6 text-center text-lg text-[#f3d59f]">Đang tải danh sách tỉnh/thành phố…</p>}
          {provinceOptions.provincesError && <div role="alert" className="flex flex-col items-center gap-3 p-6 text-center text-[#f3d59f]"><span>{provinceOptions.provincesError}</span><button type="button" onClick={provinceOptions.retryProvinces} className="rounded-md border border-[#e1ae4e] px-4 py-2 hover:bg-[#613014]">Tải lại</button></div>}
          {!provinceOptions.provincesLoading && !provinceOptions.provincesError && <div className="grid grid-cols-2 gap-3 compact:grid-cols-1 compact:gap-2">
          {provinceOptions.provinces.map(city => {
            const selected = city.name === selection.province
            const roomCount = lobby.rooms.filter(room => room.province === city.name).length
            const playerCount = selection.provinceCounts[city.name] ?? 0
            return <button key={city.name} type="button" aria-pressed={selected} onClick={() => { selection.setProvince(city.name); selection.setProvincePickerOpen(false) }} className={`${buttonInteraction} relative isolate flex aspect-[2036/549] items-center gap-3 rounded-lg border-0 bg-transparent px-5 py-0 text-left leading-none hover:brightness-125 compact:gap-2 compact:px-3 ${selected ? 'ring-2 ring-[#ffd65b]' : ''}`}>
              <img src={provinceCard} alt="" aria-hidden="true" className="pointer-events-none absolute inset-0 z-0 block size-full object-contain" />
              <img src={roomProvinceIcon(city.name)} alt="" aria-hidden="true" className="relative z-10 block max-h-[104px] w-[104px] shrink-0 border-0 p-0 object-contain compact:max-h-20 compact:w-20" />
              <span className="relative z-10 flex min-w-0 flex-1 flex-col gap-2">
                <span className="truncate font-heading text-[28px] leading-tight compact:text-2xl">{roomProvinceLabel(city.name)}</span>
                <span aria-hidden="true" className="h-px w-full bg-gradient-to-r from-[#e5af50] via-[#e5af50]/70 to-transparent" />
                <span className="flex flex-wrap gap-x-4 gap-y-1 font-number text-xl text-[#fff0ce] compact:gap-x-2 compact:text-lg"><span className="inline-flex items-center gap-1" aria-label={`${roomCount} bàn`}><span aria-hidden="true" className="text-2xl leading-none">▦</span>{roomCount}</span><span className="inline-flex items-center gap-1" aria-label={`${playerCount} người`}><span aria-hidden="true" className="text-2xl leading-none">♟</span>{playerCount}</span></span>
              </span>
              {selected && <span aria-hidden="true" className="absolute right-2 top-2 text-lg text-[#ffe078]">✓</span>}
            </button>
          })}
          </div>}
        </div>
      </section>
    </div>}
    </div>
  </div>{entrance.entering && <OpeningCover onComplete={entrance.finishEntrance} />}<PlayerNameValidationDialog message={lobby.nameError} onClose={lobby.dismissNameError} /></>
}
